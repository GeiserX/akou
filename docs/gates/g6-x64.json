          {
            "ch": "call",
            "clip": "s02.f32",
            "end": 4.943,
            "lines": 1,
            "latencyMs": 1934.625,
            "text": "Parakeet transcribes both sides of the call."
          },
          {
            "ch": "mic",
            "clip": "s03.f32",
            "end": 8.738,
            "lines": 1,
            "latencyMs": 1291.520751953125,
            "text": "We moved the dashboards from Datadog to Grafana last week."
          },
          {
            "ch": "call",
            "clip": "s04.f32",
            "end": 9.304,
            "lines": 1,
            "latencyMs": 1541.666748046875,
            "text": "Silero decides where each segment starts and ends."
          },
          {
            "ch": "mic",
            "clip": "s05.f32",
            "end": 13.165,
            "lines": 1,
            "latencyMs": 1276.520751953125,
            "text": "The Terraform Plan touched three Kubernetes clusters."
          },
          {
            "ch": "call",
            "clip": "s06.f32",
            "end": 13.523,
            "lines": 1,
            "latencyMs": 1780.208251953125,
            "text": "Please open a Zendesk ticket for the billing question."
