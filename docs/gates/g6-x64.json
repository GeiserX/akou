            "ch": "call",
            "clip": "s10.f32",
            "end": 22.027,
            "lines": 1,
            "latencyMs": 1516.416748046875,
            "text": "Opus files stay playable while they are being written."
          },
          {
            "ch": "mic",
            "clip": "s11.f32",
            "end": 24.729,
            "lines": 1,
            "latencyMs": 1203.416748046875,
            "text": "Can you share the Grafana link with the team?"
