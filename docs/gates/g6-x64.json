            "clip": "s08.f32",
            "end": 17.806,
            "lines": 1,
            "latencyMs": 1395.583251953125,
            "text": "The final pass runs pianoed over the whole call."
          },
          {
            "ch": "mic",
            "clip": "s09.f32",
            "end": 20.963,
            "lines": 1,
            "latencyMs": 1734.020751953125,
            "text": "ElectroBun hosts the window and the tray item."
