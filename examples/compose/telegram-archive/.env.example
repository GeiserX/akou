# The variables compose.akou.yml reads. Add them to the .env beside Telegram-Archive's
# docker-compose.yml.

# The drumsergio/akou version to run. There is no latest tag: name one.
AKOU_VERSION=

# Printed once by `akou keys create --name archive --scope jobs --callback-host telegram-viewer`:
# the ak_ key for the backup, and the whsec_ secret the viewer checks each callback with.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_WEBHOOK_SECRET=
