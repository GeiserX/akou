{
  "name": "akou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "check": "bun scripts/ci/bun-version.ts && biome check && tsc --noEmit && tsc --noEmit -p tsconfig.ui.json && bun test --reporter=junit --reporter-outfile=.junit-check.xml && bun scripts/ci/test-floor.ts check .junit-check.xml",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.ui.json",
    "test": "bun test",
    "test:ui": "bun test --path-ignore-patterns='nothing/**' --timeout 60000 ./tests/ui/",
    "build:ui": "bun src/main/window/bundle.ts",
    "openapi": "bun scripts/openapi.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bun": "1.4.2",
    "electrobun": "2.0.1",
    "gpt-tokenizer": "4.0.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "sherpa-onnx-node": "1.13.8",
    "zod": "4.6.5"
  }
}
